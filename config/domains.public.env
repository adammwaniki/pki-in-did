# Public deployment profile.
#
# These names resolve directly to this server (156.67.105.185) with no Cloudflare proxy, so
# `did:web` documents here are resolvable from anywhere and TLS is real Let's Encrypt,
# obtained by the Caddy already running on this host. That is what brief step 10 asked for.
#
# Use with:  DOMAINS_FILE=config/domains.public.env  (see deploy/README.md)
#
# The bare domains are NOT used: they are Cloudflare-fronted and serve unrelated content.

# domain1.com : National Root CA public distribution point (HTTPS, root certificate only)
NRCA_DOMAIN=nrca.labs.adamndegwa.com

# domain2.com : Issuing CA -- OCSP responder and CRL, on plain HTTP as the brief specifies
ISSUING_CA_DOMAIN=ca.labs.mwaniki.dev

# domain3.com : Credential issuer A -- revocation checked with OCSP
ISSUER_A_DOMAIN=issuer-a.labs.jacarandapropaganda.com

# domain4.com : Credential issuer B -- revocation checked with a CRL
ISSUER_B_DOMAIN=issuer-b.labs.lawnbull.com

# Derived DIDs. These are the real, publicly resolvable identifiers.
ISSUER_A_DID=did:web:issuer-a.labs.jacarandapropaganda.com
ISSUER_B_DID=did:web:issuer-b.labs.lawnbull.com

# Revocation endpoints baked into the leaf certificates.
OCSP_URL=http://ca.labs.mwaniki.dev/ocsp
CRL_URL=http://ca.labs.mwaniki.dev/issuing-ca.crl
CHAIN_URL_A=https://issuer-a.labs.jacarandapropaganda.com/.well-known/pki/issuer-chain.pem

# Freshness values selected for this demonstration (brief steps 17 and 18)
OCSP_RESPONSE_MINUTES=5
CRL_NEXTUPDATE_HOURS=1

# The CRL reason code used when withdrawing an accreditation.
#
# privilegeWithdrawn is the semantically correct reason -- the key is sound, the permission is
# gone -- but the `openssl ca` application cannot express it, in either direction, and that is
# still true of OpenSSL 3.5.8 LTS. See record/NOTES-waltid.md for the measurement.
# cessationOfOperation is in openssl's table, is close enough for this demonstration, and lets
# brief steps 16 and 18 be taken literally: stock `openssl ocsp` and `openssl ca -gencrl`.
REVOCATION_REASON=cessationOfOperation

# Demo accreditation policy OID: "accredited to issue AccreditedOperatorCredential"
ACCREDITATION_POLICY_OID=1.3.6.1.4.1.99999.1.1
ACCREDITED_CREDENTIAL_TYPE=AccreditedOperatorCredential

# Distinguished names
NRCA_DN_CN="Demo National Root CA"
ISSUING_CA_DN_CN="Demo National Issuing CA"
ISSUER_A_DN_CN="Jacaranda Propaganda Credential Issuer"
ISSUER_B_DN_CN="Lawnbull Credential Issuer"
OCSP_SIGNER_DN_CN="Demo National Issuing CA OCSP Responder"
DN_C=KE
DN_O="Demo National PKI"

# Ports the demonstration's web servers bind on the loopback interface. Caddy terminates
# TLS on 443 and proxies to these; nothing here is exposed directly.
NRCA_PORT=8480
ISSUING_CA_PORT=8481
ISSUER_A_PORT=8482
ISSUER_B_PORT=8483
